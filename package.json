{
  "name": "auth",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3001",
    "sdk:dev": "bun --filter @krak-stack/auth dev",
    "build": "bun --filter @krak-stack/auth build && bun --bun vite build",
    "start": "drizzle-kit migrate && bun run server.ts",
    "preview": "vite preview",
    "test": "bun --bun vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "type:check": "tsc --noEmit",
    "auth:generate": "bunx @better-auth/cli@latest generate --config ./src/services/auth/config.ts --output ./src/db/schema.ts",
    "auth:migrate": "bunx @better-auth/cli@latest migrate --config ./src/services/auth/config.ts",
    "shadcn:update": "for file in src/components/ui/*.tsx; do bunx shadcn@latest add -y -o $(basename \"$file\" .tsx); done",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1063.0",
    "@base-ui/react": "^1.5.0",
    "@better-auth/api-key": "^1.6.23",
    "@better-auth/core": "^1.6.23",
    "@better-auth/oauth-provider": "^1.6.23",
    "@distilled.cloud/aws": "1.0.0-rc.6",
    "@distilled.cloud/cloudflare": "1.0.0-rc.6",
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@krak-stack/auth": "workspace:*",
    "@krak-stack/registry": "0.1.25",
    "@lucas-barake/effect-form-react": "0.26.0-beta.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@react-email/components": "1.0.12",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.25",
    "@tanstack/react-virtual": "^3.14.5",
    "better-auth": "^1.6.23",
    "better-auth-drizzle-adapter": "^1.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.112",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.21.0",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-qr-code": "^2.2.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.14.6",
    "@effect/vitest": "4.0.0-rc.112",
    "@inlang/paraglide-js": "^2.18.2",
    "@oxlint/plugins": "^1.79.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.68.0",
    "typescript": "7.0.1-rc",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
