{
  "name": "auth",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3001",
    "sdk:dev": "bun --filter @krak-stack/auth dev",
    "build": "bun --filter @krak-stack/auth build && bun --bun vite build",
    "start": "drizzle-kit migrate && bun run server.ts",
    "preview": "vite preview",
    "test": "bun --bun vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check .",
    "type:check": "tsc --noEmit",
    "auth:generate": "bun x auth generate --config ./src/services/auth/config.ts --output ./src/db/schema.ts",
    "auth:migrate": "bun x auth migrate --config ./src/services/auth/config.ts",
    "shadcn:update": "for file in src/components/ui/*.tsx; do bunx shadcn@latest add -y -o $(basename \"$file\" .tsx); done",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1137.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.6",
    "@better-auth/core": "1.7.6",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@distilled.cloud/aws": "1.0.0-rc.6",
    "@distilled.cloud/cloudflare": "1.0.0-rc.6",
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@krak-stack/auth": "workspace:*",
    "@krak-stack/registry": "^0.1.32",
    "@lucas-barake/effect-form-react": "0.26.0-beta.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@react-email/components": "1.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.14.0",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "@tanstack/react-virtual": "^3.14.13",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.3",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.112",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.14.6",
    "@effect/vitest": "4.0.0-rc.112",
    "@inlang/paraglide-js": "^2.25.4",
    "@oxlint/plugins": "1.79.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "1.7.6",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.52.0",
    "oxlint": "1.73.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@lucas-barake/effect-form": "0.25.0-beta.6"
  }
}
