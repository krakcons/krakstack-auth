{
  "name": "@krak-stack/auth",
  "version": "0.2.3",
  "description": "Effect HttpApi clients and schemas for KrakStack Auth.",
  "license": "MIT",
  "files": [
    "dist",
    "tailwind.css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./access/matrix": {
      "types": "./dist/components/project-access-matrix.d.ts",
      "default": "./dist/components/project-access-matrix.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./auth": {
      "types": "./dist/auth/api.group.d.ts",
      "default": "./dist/auth/api.group.js"
    },
    "./extra": {
      "types": "./dist/extra/api.group.d.ts",
      "default": "./dist/extra/api.group.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./admin": {
      "types": "./dist/admin/api.group.d.ts",
      "default": "./dist/admin/api.group.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:watch": "rm -rf dist && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev": "bun run build:watch",
    "prepack": "bun run build",
    "type:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@krak-stack/registry": "0.1.24",
    "react-qr-code": "^2.2.0"
  },
  "peerDependencies": {
    "@effect/atom-react": "4.0.0-rc.112",
    "@lucas-barake/effect-form-react": "^0.26.0-beta.5",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^9.1.2",
    "effect": "4.0.0-rc.112",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "sonner": "^2.0.7"
  }
}
