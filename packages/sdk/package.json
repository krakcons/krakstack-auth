{
  "name": "@krak-stack/auth",
  "version": "0.1.50",
  "description": "Effect HttpApi clients and schemas for KrakStack Auth.",
  "license": "MIT",
  "files": [
    "dist",
    "tailwind.css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "default": "./dist/query.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./better-auth": {
      "types": "./dist/better-auth/api.group.d.ts",
      "default": "./dist/better-auth/api.group.js"
    },
    "./extra": {
      "types": "./dist/extra/api.group.d.ts",
      "default": "./dist/extra/api.group.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./admin": {
      "types": "./dist/admin/api.group.d.ts",
      "default": "./dist/admin/api.group.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:watch": "rm -rf dist && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev": "bun run build:watch",
    "prepack": "bun run build",
    "type:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react-qr-code": "^2.2.0"
  },
  "peerDependencies": {
    "@better-auth/api-key": "^1.6.14",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.14",
    "effect": "^4.0.0-beta.78",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7"
  }
}
