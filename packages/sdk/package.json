{
  "name": "@krak-stack/auth",
  "version": "0.1.11",
  "description": "Effect HttpApi clients and schemas for KrakStack Auth.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth/index.d.ts",
      "default": "./dist/better-auth/index.js"
    },
    "./extra": {
      "types": "./dist/extra/index.d.ts",
      "default": "./dist/extra/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "bun run build",
    "type:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@better-auth/api-key": "^1.6.14",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.14",
    "effect": "^4.0.0-beta.78",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-qr-code": "^2.1.1"
  }
}
